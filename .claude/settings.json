{
  "permissions": {
    "allow": [
      "mcp__Google_Drive__update_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/herramientas/proyectos.mjs\" inicio" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/herramientas/proyectos.mjs\" hook" }
        ]
      }
    ]
  }
}
